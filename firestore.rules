rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read: if isAdmin();
    }

    match /config/announcement {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /notifications/{id} {
      // Targeting is client-side only for now; tighten when toUid sends ship.
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /adminLogs/{logId} {
      allow read: if isAdmin();
      // Written only by Cloud Functions (Admin SDK bypasses rules)
      allow write: if false;
    }

    match /emails/{emailId} {
      allow read: if isAdmin();
      // Written only by adminSendEmail Cloud Function (Admin SDK bypasses rules)
      allow write: if false;
    }

    match /reminders/{id} {
      allow read, write: if isAdmin();
    }
  }
}
